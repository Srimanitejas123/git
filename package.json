{
  "scripts": {
  "cy:open": "cypress open",
  "cy:run": "cypress run",
  "report:merge": "mochawesome-merge cypress/reports/*.json > cypress/reports/report.json",
  "report:html": "marge cypress/reports/report.json --reportDir cypress/reports --reportFilename index.html",
  "report": "npm run report:merge && npm run report:html"
},
  "devDependencies": {
    "cypress": "^15.10.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.0",
    "mochawesome-report-generator": "^6.3.2"
  }
}
